DATABASE_URL="postgresql://bazaar:bazaar@localhost:5432/bazaar?schema=public"
PORT=4000
BASE_DOMAIN=localhost

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

TRIAL_DAYS=7
LANDING_URL=http://localhost:5175
ADMIN_URL=http://localhost:5173
# Optional - storefront address used in agent referral links, "{subdomain}"
# is replaced with the shop's subdomain. Defaults to
# https://{subdomain}.<BASE_DOMAIN> (http://{subdomain}.localhost:5174 in dev).
# STOREFRONT_URL_TEMPLATE=https://{subdomain}.ubazaar.uz

SUPERADMIN_EMAIL=superadmin@bazaar.uz
SUPERADMIN_PASSWORD=change-me-super-secret

# Optional - the AI advisor feature (packages/admin's "AI-советник" page)
# returns a friendly 503 instead of working when this is unset.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
